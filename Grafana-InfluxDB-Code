version: '3.8'
services:
  grafana:
    image: grafana/grafana:latest
    container_name: Monitor-Grafana
    ports:
      - 3000:3000
    volumes:
      - /home/influxdb/grafana/data:/var/lib/grafana 
    user: "1000:1000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=sdjhnvksjdv





version: '3.8'
services:
  influxdb:
    image: influxdb
    container_name: Monitor-InfluxDB
    ports:
      - 8086:8086
    volumes:
      - /home/influxdb/influxdb/data:/var/lib/influxdb2
      - /home/influxdb/influxdb/config:/etc/influxdb2
    restart: always
